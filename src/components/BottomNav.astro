---
interface Props {
  phone?: string;
}

const { phone } = Astro.props;
const whatsappUrl = phone ? `https://wa.me/${phone.replace(/[^0-9]/g, '')}` : '#';
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-20 bg-white/90 backdrop-blur-md border-t border-gray-200 px-6 py-2 pb-[env(safe-area-inset-bottom,8px)] transition-transform duration-300" id="bottom-nav">
  <div class="flex items-center justify-between">
    <a href="/" class="flex flex-col items-center gap-0.5 text-gray-500 hover:text-gray-900 transition-colors py-1">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
      </svg>
      <span class="text-[10px]">Inicio</span>
    </a>
    <a href="/?focus=search" class="flex flex-col items-center gap-0.5 text-gray-500 hover:text-gray-900 transition-colors py-1">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
      <span class="text-[10px]">Buscar</span>
    </a>
    <a href="/favoritos" class="flex flex-col items-center gap-0.5 text-gray-500 hover:text-gray-900 transition-colors py-1">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
      </svg>
      <span class="text-[10px]">Favoritos</span>
    </a>
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center gap-0.5 text-gray-500 hover:text-gray-900 transition-colors py-1">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span class="text-[10px]">Contacto</span>
    </a>
  </div>
</nav>

<script is:inline>
  (function() {
    function setup() {
      const nav = document.getElementById('bottom-nav');
      if (!nav) return;

      function update() {
        const isProductPage = window.location.pathname.startsWith('/cuadro/');
        if (isProductPage) {
          nav.style.transform = window.scrollY > 150 ? 'translateY(0)' : 'translateY(100%)';
        } else {
          nav.style.transform = 'translateY(0)';
        }
      }

      update();
      window.addEventListener('scroll', update, { passive: true });
    }

    setup();
    document.addEventListener('astro:after-swap', setup);
  })();
</script>
